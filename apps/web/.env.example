# Database (Neon PostgreSQL)
DATABASE_URL=

# Better-Auth (min 32 characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# YouTube Data API v3
YOUTUBE_API_KEY=

# Google OAuth (optional — enables "Continue with Google" button)
# Get credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# CORS
CORS_ORIGIN=http://localhost:3001

# Polar Payments (optional — not used in MVP)
# POLAR_ACCESS_TOKEN=
# POLAR_SUCCESS_URL=
